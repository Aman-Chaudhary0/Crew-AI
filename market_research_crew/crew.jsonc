{
  // Display name for this crew
  "name": "market-research-crew",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["market_research_specialist", "competitive_intelligence_analy", "customer_insights_researcher", "product_strategy_advisor", "business_analyst_and_report_sy"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "conduct_comprehensive_market_research_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Conduct comprehensive market research for the AI product idea: . Your analysis must include: 1. Market Size and Growth: Total Addressable Market (TAM), Serviceable Addressable Market (SAM), and Serviceable Obtainable Market (SOM); historical growth rates and future projections (3\u20135 years); market maturity stage and growth drivers. 2. Industry Trends and Dynamics: Key technology trends shaping the market; AI adoption patterns in the target industry; emerging opportunities and threats; industry consolidation or fragmentation trends. 3. Regulatory Landscape: Relevant regulations and compliance requirements; data privacy and security considerations; industry-specific regulatory constraints; upcoming regulatory changes that may impact the market. 4. Technology Readiness: Current state of enabling technologies; infrastructure requirements and availability; integration ecosystem maturity. Use web search to gather the most current market data, industry reports, and analyst insights. Cite all sources and provide data-backed conclusions.",

      // Clear definition of what the output should look like
      "expected_output": "A detailed market research report (1500-2000 words) with: - Executive summary of market opportunity - Quantitative market sizing with sources - Industry trend analysis with supporting data - Regulatory landscape overview - Technology readiness assessment - Key findings and implications for the product Format the report with clear sections, bullet points for key findings, and include all data sources.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "market_research_specialist"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "conduct_thorough_competitive_intelligence_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Conduct thorough competitive intelligence analysis for the AI product idea: . Building on the market landscape understanding, your analysis must include: 1. Competitor Identification: Direct competitors (solving same problem, same approach); indirect competitors (solving same problem, different approach); adjacent competitors (related solutions that could expand into this space); emerging competitors and startups in stealth mode. 2. Competitive Analysis Matrix: Company overview (funding, team size, founding year); core product features and capabilities; technology stack and approach; target customer segments; pricing models and tiers; go-to-market strategy; strengths and weaknesses. 3. Market Positioning: How competitors position themselves; their unique value propositions; brand perception and market reputation; customer reviews and satisfaction levels. 4. Competitive Gaps and Opportunities: Under-served customer needs; feature gaps in existing solutions; pricing gaps or opportunities; market segments with weak competition. 5. Competitive Threats: Barriers to entry they've created; network effects or lock-in strategies; potential competitive responses to new entrant. Use web search extensively to research each competitor. Analyze their websites, product documentation, customer reviews, and recent news.",

      // Clear definition of what the output should look like
      "expected_output": "A comprehensive competitive intelligence report (2000-2500 words) with: - Executive summary of competitive landscape - Detailed competitor profiles (at least 5-7 competitors) - Competitive comparison matrix (table format) - Market positioning map - Analysis of competitive gaps and opportunities - Strategic recommendations for differentiation. Include links to competitor websites and sources for all claims.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "competitive_intelligence_analy",

      // Task outputs used as context
      "context": ["conduct_comprehensive_market_research_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "develop_deep_customer_insights_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Develop deep customer insights for the AI product idea: . Leveraging market trends and competitive intelligence, your analysis must include: 1. Target Customer Segmentation: Identify 3\u20134 distinct customer segments; segment size and characteristics; prioritization of segments (primary vs. secondary); segment attractiveness analysis. 2. Detailed Customer Personas: For each key segment, create detailed personas including demographics and firmographics; role and responsibilities; goals and success metrics; current workflows and tools; decision-making process and criteria; budget authority and procurement process. 3. Pain Points and Needs Analysis: Critical pain points the product would solve; current workarounds and their limitations; urgency and severity of problems; unmet needs in current solutions (from competitive analysis). 4. Customer Journey Mapping: Awareness stage\u2014how customers discover solutions; consideration stage\u2014evaluation criteria and process; purchase stage\u2014decision factors and barriers; adoption stage\u2014onboarding and activation needs. 5. Value Proposition Validation: What outcomes customers truly care about; willingness-to-pay indicators; expected ROI or value metrics; deal-breakers and must-have features. 6. Customer Acquisition Channels: Where target customers can be found; most effective marketing channels; community and influencer landscape; partnership opportunities. Use web search to find customer reviews of competitor products, forum discussions, social media conversations, and industry surveys to understand real customer voices.",

      // Clear definition of what the output should look like
      "expected_output": "A comprehensive customer insights report (2000-2500 words) with: - Executive summary of customer landscape - Customer segmentation framework with prioritization - Detailed personas for 2-3 primary segments (with visual elements if possible) - Pain points matrix mapping problems to segments - Customer journey maps - Value proposition framework - Customer acquisition strategy recommendations. Include real customer quotes from reviews and forums where possible.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "customer_insights_researcher",

      // Task outputs used as context
      "context": ["conduct_comprehensive_market_research_task", "conduct_thorough_competitive_intelligence_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "develop_a_comprehensive_product_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Develop a comprehensive product strategy for the AI product idea: . Synthesizing insights from market research, competitive analysis, and customer research, your strategy must include: 1. Product Vision and Positioning: Clear product vision statement; unique value proposition; positioning strategy vs. competitors; brand personality and messaging direction. 2. MVP Feature Prioritization: Core features for MVP (must-haves); supporting features for MVP (should-haves); features to defer post-MVP (nice-to-haves); feature prioritization rationale using frameworks like customer impact vs. development effort, competitive necessity vs. differentiation, and technical dependencies; create a feature prioritization matrix. 3. Product Differentiation Strategy: Key differentiators vs. each major competitor; defensibility of differentiation (moats); how differentiation aligns with customer priorities; areas where \"good enough\" is acceptable. 4. Technical Feasibility Assessment: Technology stack recommendations; technical risks and mitigation strategies; required technical capabilities and skills; infrastructure and scalability considerations; integration requirements; data requirements and availability. 5. Development Roadmap: Phase 1: MVP (0\u20133 months); Phase 2: Product-market fit iteration (3\u20136 months); Phase 3: Scale and expansion (6\u201312 months); key milestones and success metrics for each phase. 6. Success Metrics: Product KPIs to track; user engagement metrics; product-market fit indicators; technical performance benchmarks. Use technical documentation, architecture blogs, and technology trend reports to validate technical feasibility.",

      // Clear definition of what the output should look like
      "expected_output": "A detailed product strategy document (2500-3000 words) with: - Executive summary of product strategy - Product vision and positioning statement - MVP feature list with prioritization matrix (table format) - Differentiation strategy vs. each major competitor - Technical architecture recommendations - Risk assessment and mitigation strategies - 12-month product roadmap with phases and milestones - Success metrics framework. Include visual elements like feature prioritization matrix and roadmap timeline.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "product_strategy_advisor",

      // Task outputs used as context
      "context": ["conduct_comprehensive_market_research_task", "conduct_thorough_competitive_intelligence_task", "develop_deep_customer_insights_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "create_a_comprehensive_business_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Create a comprehensive business analysis and final recommendation report for the AI product idea: . Synthesizing ALL prior research and analysis, your report must include: 1. Executive Summary: One-page overview of the opportunity; key findings from each research area; overall recommendation (Go/No-Go/Conditional); critical success factors. 2. Pricing Strategy: Recommended pricing model (subscription, usage-based, freemium, etc.); pricing tiers and packaging; price points with justification based on customer willingness to pay, competitor pricing benchmarks, value delivered to customers, and cost structure considerations; pricing psychology and positioning; discounting and promotional strategy. 3. Revenue Model and Projections: Revenue streams; unit economics (CAC, LTV, payback period); 3-year revenue projections with assumptions; break-even analysis; path to profitability. 4. Go-to-Market Strategy: Launch strategy and timeline; customer acquisition strategy; sales model (self-service, inside sales, field sales); marketing channel mix; partnership strategy; initial target market focus. 5. Resource Requirements: Team composition and hiring plan; technology infrastructure costs; marketing and sales budget; total funding requirement; burn rate and runway projections. 6. Risk Analysis: Market risks and mitigation strategies; competitive risks and responses; technical risks and contingency plans; execution risks and dependencies; financial risks and sensitivities. 7. Investment Thesis: Why this opportunity is attractive; key value drivers; exit potential and comparables; investment risks to consider. 8. Final Recommendation: Clear Go/No-Go recommendation with reasoning; if Go, critical next steps and priorities; if No-Go, what would need to change; if Conditional, what needs to be validated first. This is the culmination report that brings everything together. Make it compelling, data-driven, and actionable.",

      // Clear definition of what the output should look like
      "expected_output": "A comprehensive business analysis report (3000-4000 words) formatted as a professional investment memo with: - Executive summary (1 page) - Pricing strategy with detailed tier breakdown (table format) - Financial projections (tables with 3-year forecast) - Go-to-market plan - Resource requirements and budget - Risk matrix (likelihood vs. impact) - Investment thesis - Final recommendation with clear reasoning. The report should be formatted professionally with clear section headers and headings, executive-friendly visualizations and tables, data citations from all previous research, and actionable next steps. This should be a report ready to present to investors or executive leadership.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "business_analyst_and_report_sy",

      // Task outputs used as context
      "context": ["conduct_comprehensive_market_research_task", "conduct_thorough_competitive_intelligence_task", "develop_deep_customer_insights_task", "develop_a_comprehensive_product_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }

  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": true,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "market_research_specialist",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {
    "product_idea": "An AI powered tool that summarizes youtube videos on my channel and posts the summary on various social media platforms like LinkedIn, Instagram, Facebook,X, WhatsApp"
  }
}
